# Telegram Drive – Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Telegram API (REQUIRED) ──
# Get these from https://my.telegram.org → API development tools
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# ── Bot Token (REQUIRED) ──
# Create a bot via @BotFather, then add it as an ADMIN to your storage channel.
BOT_TOKEN=your_bot_token_here

# ── Storage Channel (REQUIRED) ──
# Numeric ID of the ONE private channel where all files are stored.
# Tip: forward any message from the channel to @userinfobot to get the ID
# (private channel IDs look like -1001234567890).
STORAGE_CHANNEL_ID=-1001234567890

# ── Web Auth ──
# Password for the web UI. If unset entirely, the app defaults to "admin".
APP_PASSWORD=change_me

# ── Database (OPTIONAL) ──
# PostgreSQL for persistent deployments (Railway / Supabase / local).
# If omitted, the app falls back to a local SQLite file (index.db).
# DATABASE_URL=postgresql://user:password@host:port/dbname

# ── CORS (OPTIONAL) ──
# Comma-separated origins allowed to call the API cross-origin.
# Only needed when the UI is served from a DIFFERENT origin than the API
# (the bundled frontend at / needs no CORS).
# ALLOWED_ORIGINS=https://mydrive.example.com,http://localhost:3000

# ── Rate Limiting (OPTIONAL, anti-ban) ──
# Minimum seconds between Telegram API calls, and max calls per minute.
# RATE_LIMIT_DELAY=2.0
# MAX_REQUESTS_PER_MINUTE=20

# ── Misc (OPTIONAL) ──
# Port for the web server. Hosting platforms usually set PORT themselves.
# PORT=8000

# NOTE: SESSION_STRING is legacy — only the debug scripts
# (generate_session.py, get_channel_id.py) still read it. The web app
# connects exclusively with BOT_TOKEN.
