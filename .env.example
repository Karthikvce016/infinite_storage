# Telegram Drive – Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Telegram API (REQUIRED) ──
# Get these from https://my.telegram.org
API_ID=32544391
API_HASH=6d97d692d02fa60805dfac5cf39b8dc6

# ── Bot Token (REQUIRED) ──
# Create a bot via @BotFather on Telegram
BOT_TOKEN=8932778983:AAEVwEHpuO_JtGeYk_rBIGtHcv2Hwns6wx0

# ── Storage Channel (REQUIRED) ──
# Create a private channel, add the bot as admin, then get the channel ID.
# Tip: Forward a message from the channel to @userinfobot to get the ID.
STORAGE_CHANNEL_ID=1001004307910144

# ── Web Auth ──
# Password to access the web UI (default: admin)
APP_PASSWORD=Karthik

# ── PostgreSQL (OPTIONAL — for Railway/Supabase) ──
# If not set, falls back to local SQLite.
# DATABASE_URL=postgresql://user:pass@host:port/dbname

# ── Rate Limiting (OPTIONAL) ──
# RATE_LIMIT_DELAY=2.0
# MAX_REQUESTS_PER_MINUTE=20
